{
  "name": "overlay-lab",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "org",
  "sourceRoot": "apps/overlay-lab/src",
  "tags": ["type:app", "scope:lab"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/overlay-lab",
        "browser": "apps/overlay-lab/src/main.ts",
        "index": "apps/overlay-lab/src/index.html",
        "tsConfig": "apps/overlay-lab/tsconfig.app.json",
        "styles": [],
        "outputHashing": "none"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "16kb",
              "maximumError": "24kb"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4300
      },
      "configurations": {
        "production": {
          "buildTarget": "overlay-lab:build:production"
        },
        "development": {
          "buildTarget": "overlay-lab:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
